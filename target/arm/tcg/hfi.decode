###########################################################################
# HFI OPS

# Available format: ....1...    ........    ........    ........
#                   31    24    23    16    15     8    7      0

###########################################################################

# old stuff (to be deleted)
@cstm           ... ...... . ............ rn:5  rd:5
@hfi_sr         ... ...... . ............. region_number:4  region_ptr_gpr:5
CSTM            111 001111 1 111111111111 ..... .....  @cstm
HFI_SR          111 001111 1 000000000000 0.... .....  @hfi_sr

###########################################################################
# Named instruction formats.

@blank          ........ ........ ........ ........
@gpr            ........ ........ ........ ... gpr:5
@gpr_gpr        ........ ........ ...... rn:5 gpr:5
@optr_gpr       ........ ........ ......  optr:5 gpr:5

###########################################################################
# HFI Instructions

HFI_SRB         00000010 00000000 000000 ..... .....      @gpr_gpr
HFI_GRB         00000010 00000001 000000 ..... .....      @gpr_gpr
HFI_SRM         00000010 00000010 000000 ..... .....      @gpr_gpr
HFI_GRM         00000010 00000011 000000 ..... .....      @gpr_gpr
HFI_SRP         00000010 00000100 000000 ..... .....      @gpr_gpr
HFI_GRP         00000010 00000101 000000 ..... .....      @gpr_gpr

HFI_SEH         00000010 00000110 00000000 000 .....      @gpr
HFI_GEH         00000010 00000111 00000000 000 .....      @gpr

HFI_ENTER       00000010 00001000 000000 ..... .....      @optr_gpr
HFI_EXIT        00000010 00001001 00000000 00000000       @blank

HFI_GFS         00000010 00001010 00000000 000 .....      @gpr
HFI_SFS         00000010 00001011 00000000 000 .....      @gpr
HFI_GES         00000010 00001100 00000000 000 .....      @gpr
HFI_SES         00000010 00001101 00000000 000 .....      @gpr


# H-Prefixed instructions. Copy format of the non-H-prefixed instruction, use bits for rn1 encoding for region region_number
# Load/store register (unscaled immediate)
&hldst_imm       rt rn imm sz rn1 w p unpriv rn2
@hldst_imm       .. ... . .. .. . imm:s9 .. rn:5 rt:5 &hldst_imm unpriv=0 p=0 w=0
@hldst_imm_pre   .. ... . .. .. . imm:s9 .. rn:5 rt:5 &hldst_imm unpriv=0 p=0 w=1
@hldst_imm_post  .. ... . .. .. . imm:s9 .. rn:5 rt:5 &hldst_imm unpriv=0 p=1 w=1
@hldst_imm_user  .. ... . .. .. . imm:s9 .. rn:5 rt:5 &hldst_imm unpriv=1 p=0 w=0

HSTR_i           sz:2 001 1 00 00 0 ......... 00 ..... ..... @hldst_imm rn1=0 rn2=0
HLDR_i           00 001 1 00 01 0 ......... 00 ..... ..... @hldst_imm rn1=0 rn2=1 sz=0
HLDR_i           01 001 1 00 01 0 ......... 00 ..... ..... @hldst_imm rn1=0 rn2=1 sz=1
HLDR_i           10 001 1 00 01 0 ......... 00 ..... ..... @hldst_imm rn1=0 rn2=1 sz=2
HLDR_i           11 001 1 00 01 0 ......... 00 ..... ..... @hldst_imm rn1=0 rn2=0 sz=3
HLDR_i           00 001 1 00 10 0 ......... 00 ..... ..... @hldst_imm rn1=1 rn2=0 sz=0
HLDR_i           01 001 1 00 10 0 ......... 00 ..... ..... @hldst_imm rn1=1 rn2=0 sz=1
HLDR_i           10 001 1 00 10 0 ......... 00 ..... ..... @hldst_imm rn1=1 rn2=0 sz=2
HLDR_i           00 001 1 00 11 0 ......... 00 ..... ..... @hldst_imm rn1=1 rn2=1 sz=0
HLDR_i           01 001 1 00 11 0 ......... 00 ..... ..... @hldst_imm rn1=1 rn2=1 sz=1

HSTR_i           sz:2 001 1 00 00 0 ......... 01 ..... ..... @hldst_imm_post rn1=0 rn2=0
HLDR_i           00 001 1 00 01 0 ......... 01 ..... ..... @hldst_imm_post rn1=0 rn2=1 sz=0
HLDR_i           01 001 1 00 01 0 ......... 01 ..... ..... @hldst_imm_post rn1=0 rn2=1 sz=1
HLDR_i           10 001 1 00 01 0 ......... 01 ..... ..... @hldst_imm_post rn1=0 rn2=1 sz=2
HLDR_i           11 001 1 00 01 0 ......... 01 ..... ..... @hldst_imm_post rn1=0 rn2=0 sz=3
HLDR_i           00 001 1 00 10 0 ......... 01 ..... ..... @hldst_imm_post rn1=1 rn2=0 sz=0
HLDR_i           01 001 1 00 10 0 ......... 01 ..... ..... @hldst_imm_post rn1=1 rn2=0 sz=1
HLDR_i           10 001 1 00 10 0 ......... 01 ..... ..... @hldst_imm_post rn1=1 rn2=0 sz=2
HLDR_i           00 001 1 00 11 0 ......... 01 ..... ..... @hldst_imm_post rn1=1 rn2=1 sz=0
HLDR_i           01 001 1 00 11 0 ......... 01 ..... ..... @hldst_imm_post rn1=1 rn2=1 sz=1

HSTR_i           sz:2 001 1 00 00 0 ......... 10 ..... ..... @hldst_imm_user rn1=0 rn2=0
HLDR_i           00 001 1 00 01 0 ......... 10 ..... ..... @hldst_imm_user rn1=0 rn2=1 sz=0
HLDR_i           01 001 1 00 01 0 ......... 10 ..... ..... @hldst_imm_user rn1=0 rn2=1 sz=1
HLDR_i           10 001 1 00 01 0 ......... 10 ..... ..... @hldst_imm_user rn1=0 rn2=1 sz=2
HLDR_i           11 001 1 00 01 0 ......... 10 ..... ..... @hldst_imm_user rn1=0 rn2=0 sz=3
HLDR_i           00 001 1 00 10 0 ......... 10 ..... ..... @hldst_imm_user rn1=1 rn2=0 sz=0
HLDR_i           01 001 1 00 10 0 ......... 10 ..... ..... @hldst_imm_user rn1=1 rn2=0 sz=1
HLDR_i           10 001 1 00 10 0 ......... 10 ..... ..... @hldst_imm_user rn1=1 rn2=0 sz=2
HLDR_i           00 001 1 00 11 0 ......... 10 ..... ..... @hldst_imm_user rn1=1 rn2=1 sz=0
HLDR_i           01 001 1 00 11 0 ......... 10 ..... ..... @hldst_imm_user rn1=1 rn2=1 sz=1

HSTR_i           sz:2 001 1 00 00 0 ......... 11 ..... ..... @hldst_imm_pre rn1=0 rn2=0
HLDR_i           00 001 1 00 01 0 ......... 11 ..... ..... @hldst_imm_pre rn1=0 rn2=1 sz=0
HLDR_i           01 001 1 00 01 0 ......... 11 ..... ..... @hldst_imm_pre rn1=0 rn2=1 sz=1
HLDR_i           10 001 1 00 01 0 ......... 11 ..... ..... @hldst_imm_pre rn1=0 rn2=1 sz=2
HLDR_i           11 001 1 00 01 0 ......... 11 ..... ..... @hldst_imm_pre rn1=0 rn2=0 sz=3
HLDR_i           00 001 1 00 10 0 ......... 11 ..... ..... @hldst_imm_pre rn1=1 rn2=0 sz=0
HLDR_i           01 001 1 00 10 0 ......... 11 ..... ..... @hldst_imm_pre rn1=1 rn2=0 sz=1
HLDR_i           10 001 1 00 10 0 ......... 11 ..... ..... @hldst_imm_pre rn1=1 rn2=0 sz=2
HLDR_i           00 001 1 00 11 0 ......... 11 ..... ..... @hldst_imm_pre rn1=1 rn2=1 sz=0
HLDR_i           01 001 1 00 11 0 ......... 11 ..... ..... @hldst_imm_pre rn1=1 rn2=1 sz=1
