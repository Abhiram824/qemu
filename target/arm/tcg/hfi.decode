###########################################################################
# HFI OPS

# Available format: ....1...    ........    ........    ........
#                   31    24    23    16    15     8    7      0

###########################################################################

# old stuff (to be deleted)
@cstm           ... ...... . ............ rn:5  rd:5
@hfi_sr         ... ...... . ............. region_number:4  region_ptr_gpr:5
CSTM            111 001111 1 111111111111 ..... .....  @cstm
HFI_SR          111 001111 1 000000000000 0.... .....  @hfi_sr

###########################################################################
# Named instruction formats.

@blank          ........ ........ ........ ........
@gpr            ........ ........ ........ ... gpr:5
@gpr_reg        ........ ........ ....... rn:4 gpr:5
@optr_gpr       ........ ........ ......  optr:5 gpr:5

###########################################################################
# HFI Instructions

HFI_SRB         00000010 00000000 0000000 .... .....      @gpr_reg
HFI_GRB         00000010 00000001 0000000 .... .....      @gpr_reg
HFI_SRM         00000010 00000010 0000000 .... .....      @gpr_reg
HFI_GRM         00000010 00000011 0000000 .... .....      @gpr_reg
HFI_SRP         00000010 00000100 0000000 .... .....      @gpr_reg
HFI_GRP         00000010 00000101 0000000 .... .....      @gpr_reg

HFI_SEH         00000010 00000110 00000000 000 .....      @gpr
HFI_GEH         00000010 00000111 00000000 000 .....      @gpr

HFI_ENTER       00000010 00001000 000000 ..... .....      @optr_gpr
HFI_EXIT        00000010 00001001 00000000 00000000       @blank